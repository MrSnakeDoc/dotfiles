#!/bin/zsh
# zsh_git_func


gconf() {
  name="MrSnakeDoc"
  email="88565442+MrSnakeDoc@users.noreply.github.com"
  git config --global user.name "$name"
  echo "✅ Git global user.name set to '$name'"
  git config --global user.email "$email"
  echo "✅ Git global user.email set to '$email'"
}

gps() {
  local branch
  branch=$(git symbolic-ref --short HEAD)
  git push -u origin "$branch"
}

gfo() {
  local branch
  branch=$(git symbolic-ref --short HEAD)
  git fetch origin "$branch:$branch"
}

gtag() {
  if [[ -z "$1" ]]; then
    echo "Usage: gtag <version>" >&2
    return 1
  fi

  local ver
  [[ "$1" == v* ]] && ver="$1" || ver="v$1"

  git tag -a "$ver" -m "$ver"
}

gltag() {
  local last
  last=$(git describe --tags --abbrev=0 2>/dev/null) || {
    echo "🛑  No tag found." >&2
    return 1
  }
  echo "🚀 Pushing $last to origin…"
  git push origin "$last"
}

if_has go && {
  gomi() {
    if [ -z "$1" ]; then
      echo "Usage: gomi <module-name>"
      return 1
    fi

    go mod init "github.com/MrSnakeDoc/$1"
  }
}

# Squash all commits on current branch since base (auto-detected) into a single commit.
# Lazy mode: just pass the commit message; no flags.
gsq() {
  local force=0
  local all=0
  local message=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
    -f | --force)
      force=1
      shift
      ;;
    -a | --all)
      all=1
      shift
      ;;
    --)
      shift
      message="$*"
      break
      ;;
    *)
      message="$*"
      break
      ;;
    esac
  done

  local branch
  branch="$(git symbolic-ref --quiet --short HEAD)" || {
    echo "❌ HEAD is detached. Checkout a branch before squashing."
    return 1
  }

  case "$branch" in
  main | master | staging)
    if [[ "$force" -ne 1 ]]; then
      echo "❌ Refusing to squash protected branch: $branch"
      echo "   Use -f or --force to override."
      return 1
    fi
    echo "⚠️  Force mode enabled for protected branch: $branch"
    ;;
  esac

  if ! git diff --quiet || ! git diff --cached --quiet; then
    echo "❌ Working tree is dirty. Commit or stash changes first."
    return 1
  fi

  if [[ "$all" -eq 1 ]]; then
    local commit_count
    commit_count="$(git rev-list --count HEAD)"

    if [[ "$commit_count" -le 1 ]]; then
      echo "ℹ️ '$branch' already has a single-commit history."
      return 0
    fi

    echo "⚠️  Squashing all $commit_count reachable commits on '$branch' into one root commit."
    git --no-pager log --oneline --decorate --graph --abbrev-commit | sed -n '1,10p'

    local timestamp backup_branch new_commit
    timestamp="$(date +%Y%m%d-%H%M%S)"
    backup_branch="backup/${branch//\//-}-$timestamp"
    if ! git branch "$backup_branch"; then
      echo "❌ Failed to create safety branch '$backup_branch'."
      return 1
    fi
    echo "🛟 Created safety branch: $backup_branch"

    if [[ -z "$message" ]]; then
      message="squash: $branch"
    fi

    if ! new_commit="$(git commit-tree HEAD^{tree} -m "$message")"; then
      echo "❌ Failed to create the squashed commit."
      return 1
    fi
    if ! git reset --hard "$new_commit"; then
      echo "❌ Failed to move '$branch' to the squashed commit."
      return 1
    fi

    echo "✅ Squashed all history on '$branch' into one root commit."
    echo "   Backup: $backup_branch"
    echo "   Publish rewritten history with: git push --force-with-lease"
    return 0
  fi

  local upstream_ref upstream_remote upstream_branch
  upstream_ref="$(git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}')" || {
    echo "❌ No upstream configured for '$branch'."
    echo "   Configure one with: git push -u origin $branch"
    return 1
  }

  if [[ "$upstream_ref" != */* ]]; then
    echo "❌ Upstream '$upstream_ref' is not a remote-tracking branch."
    return 1
  fi

  upstream_remote="${upstream_ref%%/*}"
  upstream_branch="${upstream_ref#*/}"

  # Refresh only this branch's upstream, never every remote branch.
  if ! git fetch --quiet "$upstream_remote" "$upstream_branch"; then
    echo "❌ Failed to refresh '$upstream_ref'."
    return 1
  fi

  local ahead behind
  ahead="$(git rev-list --count "$upstream_ref..HEAD")"
  behind="$(git rev-list --count "HEAD..$upstream_ref")"

  if [[ "$behind" -gt 0 ]]; then
    echo "❌ '$branch' is behind '$upstream_ref' by $behind commit(s)."
    echo "   Update the branch before squashing."
    return 1
  fi

  if [[ "$ahead" -eq 0 ]]; then
    echo "ℹ️ Nothing to squash: '$branch' has no unpublished commits."
    return 0
  fi

  echo "🔎 Squashing $ahead unpublished commit(s) on '$branch'"
  echo "   Upstream: $upstream_ref"
  git --no-pager log --oneline --decorate --graph "$upstream_ref..HEAD"

  local timestamp backup_branch
  timestamp="$(date +%Y%m%d-%H%M%S)"
  backup_branch="backup/${branch//\//-}-$timestamp"
  if ! git branch "$backup_branch"; then
    echo "❌ Failed to create safety branch '$backup_branch'."
    return 1
  fi
  echo "🛟 Created safety branch: $backup_branch"

  if [[ -z "$message" ]]; then
    message="squash: $branch"
  fi

  if ! git reset --soft "$upstream_ref"; then
    echo "❌ Failed to prepare the squash."
    return 1
  fi
  if ! git commit -m "$message"; then
    echo "❌ Failed to create the squashed commit."
    return 1
  fi

  echo "✅ Squashed '$branch' into one commit above '$upstream_ref'."
  echo "   Backup: $backup_branch"
  echo "   Publish rewritten history with: git push --force-with-lease"
}

if_has docker && {
  dstat() {
    local n=10  # default

    # parse args
    while [[ $# -gt 0 ]]; do
      case "$1" in
        -n|--num)
          n="$2"
          shift 2
          ;;
        *)
          echo "usage: dstat [-n N]"
          return 1
          ;;
      esac
    done

    docker stats --no-stream --format "{{.Name}}\t{{.MemUsage}}" \
      | awk -F'\t' '
          {
            name = $1
            split($2, parts, " / ")
            usage = parts[1]
            limit = parts[2]

            # convert usage -> MiB
            usageMiB = usage
            if (usage ~ /GiB/) {
              gsub(/GiB/, "", usageMiB)
              usageMiB = usageMiB * 1024
            } else {
              gsub(/MiB/, "", usageMiB)
            }

            # convert limit -> MiB (some docker versions show "--" or no limit)
            limitMiB = -1
            if (limit != "" && limit != "-" ) {
              if (limit ~ /GiB/) {
                limitVal = limit
                gsub(/GiB/, "", limitVal)
                limitMiB = limitVal * 1024
              } else if (limit ~ /MiB/) {
                limitVal = limit
                gsub(/MiB/, "", limitVal)
                limitMiB = limitVal
              }
            }

            # print: usageMiB \t name \t limitMiB
            printf "%.1f\t%s\t%.1f\n", usageMiB, name, limitMiB
          }
        ' \
      | sort -nr -k1,1 \
      | head -n "$n" \
      | awk -F'\t' '
          function human(mib) {
            if (mib < 0) return "--"
            if (mib >= 1024) return sprintf("%.1f GiB", mib/1024)
            return sprintf("%.1f MiB", mib)
          }
          {
            usageHuman = human($1)
            limitHuman = human($3)
            printf "%-22s %10s  (limit: %s)\n", $2, usageHuman, limitHuman
          }
        '
  }
}

dotup() (
    cd ~/dotfiles || exit 1
    git pull --rebase
)
