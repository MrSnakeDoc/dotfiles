# Tls checker
tlscheck() {
  local host="$1"
  local port="${2:-443}"

  if [ -z "$host" ]; then
    echo "Usage: tlscheck <hostname> [port]"
    return 1
  fi

  openssl s_client \
    -connect "${host}:${port}" \
    -servername "${host}" \
    -showcerts < /dev/null
}


