if_has rdap && {
  rdaps() {
    if [[ $# -ne 1 ]]; then
        echo "Usage: rdaps <domain|ip|asn>" >&2
        return 1
    fi

    rdap --json --log-level off "$1" | jq '
        .[0] as $d |

        def event($name):
            ($d.events[]? | select(.eventAction == $name) | .eventDate) // null;

        def registrar:
            ($d.entities[]?
                | select(.roles[]? == "registrar"));

        def abuse:
            (registrar.entities[]?
                | select(.roles[]? == "abuse"));

        def dnssec_algo($id):
            {
                "8":  "RSA/SHA-256",
                "10": "RSA/SHA-512",
                "13": "ECDSA P-256",
                "14": "ECDSA P-384",
                "15": "Ed25519",
                "16": "Ed448"
            }[$id|tostring] // "Unknown";

        def digest_algo($id):
            {
                "1": "SHA-1",
                "2": "SHA-256",
                "4": "SHA-384"
            }[$id|tostring] // "Unknown";

        {
            domain: ($d.ldhName | ascii_downcase),

            handle: $d.handle,

            status: ($d.status | sort),

            dates: {
                created: event("registration"),
                changed: event("last changed"),
                expires: event("expiration"),
                rdap_updated: event("last update of RDAP database")
            },

            registrar: {
                name:
                    (registrar.vcardArray[1][1][3] // null),

                iana:
                    (
                        registrar.publicIds[]
                        | select(.type == "IANA Registrar ID")
                        | .identifier
                    ),

                abuse: {
                    email:
                        (abuse.vcardArray[1][3][3] // null),

                    phone:
                        (
                            abuse.vcardArray[1][2][3]
                            | sub("^tel:"; "")
                        ) // null
                }
            },

            nameservers:
                (
                    [ $d.nameservers[].ldhName | ascii_downcase ]
                    | sort
                ),

            dnssec: {
                enabled:
                    $d.secureDNS.delegationSigned,

                zone_signed:
                    ($d.secureDNS.zoneSigned // false),

                ds:
                    (
                        ($d.secureDNS.dsData // [])
                        | map({
                            key_tag: .keyTag,
                            algorithm: {
                                id: .algorithm,
                                name: dnssec_algo(.algorithm)
                            },
                            digest: {
                                type: .digestType,
                                name: digest_algo(.digestType),
                                value: .digest
                            }
                        })
                    )
            }
        }
    '
  }
}

